{
  "name": "cct-academic-system",
  "private": true,
  "version": "0.0.0",
  "description": "Natsuki College of Imus Academic Performance Monitoring and Reporting System — React/Vite dashboard with Firebase realtime data and Supabase avatar storage.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tunnel": "npx cloudflared tunnel --url http://127.0.0.1:5173 --http-host-header localhost",
    "build": "vite build",
    "deploy": "npm run build && firebase deploy",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.17.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "@supabase/supabase-js": true,
    "protobufjs@7.6.5": true
  }
